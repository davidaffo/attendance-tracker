{
  "name": "registro-presenze",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "generate:demo": "node scripts/generate-demo-season.mjs",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:attendance": "npm run build --workspace @clubiva/attendance",
    "pack:attendance": "npm run build:attendance && npm pack --workspace @clubiva/attendance --pack-destination packages/attendance"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10",
    "postcss": "^8.5.24"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
